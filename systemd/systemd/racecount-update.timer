[Unit]
Description=Run RaceCount auto-update check periodically

[Timer]
# Wait 2 minutes after boot (let networking and the main service settle
# first), then check every 15 minutes after that. Adjust OnUnitActiveSec
# if you want updates to land faster after a push -- there's no real
# cost to checking more often since it's a no-op when there's nothing
# new (see racecount-update.sh), just a bit more GitHub API traffic.
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
