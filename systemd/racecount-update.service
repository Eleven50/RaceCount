[Unit]
Description=RaceCount auto-update check (pull + test + restart if safe)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=baileyw
ExecStart=/home/baileyw/racecount/systemd/racecount-update.sh

# Install:
#   sudo cp racecount-update.service racecount-update.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now racecount-update.timer
#
# The restart step inside racecount-update.sh needs passwordless sudo
# for exactly one command -- not broad sudo access. Add this as its own
# file under /etc/sudoers.d/ (never edit /etc/sudoers directly):
#   sudo visudo -f /etc/sudoers.d/racecount-update
# then add this single line:
#   baileyw ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart racecount.service
#
# Check it's working: journalctl -u racecount-update.service -f
# or watch the log directly: tail -f /home/baileyw/racecount/logs/auto-update.log
