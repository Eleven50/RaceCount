[Desktop Entry]
Type=Application
Name=RaceCount Kiosk
Comment=Launches the RaceCount touchscreen dashboard fullscreen after login
Exec=/home/baileyw/racecount/systemd/launch_kiosk.sh
X-GNOME-Autostart-enabled=true
NoDisplay=false

# This is the X11/XDG-standard autostart method. It works reliably
# under X11, but Raspberry Pi OS Bookworm (Oct 2024+) defaults to the
# labwc Wayland compositor, which does NOT reliably honour this file —
# see README.md's "Kiosk display setup" section for the labwc-specific
# method (a one-line addition to ~/.config/labwc/autostart), which is
# what most current installs actually need. Check `echo $XDG_SESSION_TYPE`
# and, if wayland, `ps aux | grep -E "wayfire|labwc"` to confirm which
# applies to your system before assuming this file is the right one.
#
# If you are on X11, install by copying (not symlinking — some desktop
# session managers ignore autostart symlinks) into the Pi user's
# autostart folder:
#   mkdir -p ~/.config/autostart
#   cp racecount-kiosk.desktop ~/.config/autostart/
#   chmod +x /home/baileyw/racecount/systemd/launch_kiosk.sh
#
# Either way, this only fires once the desktop session itself has
# started, i.e. after Raspberry Pi OS's auto-login (raspi-config ->
# System Options -> Boot / Auto Login -> Desktop Autologin) — without
# auto-login the dashboard won't appear until someone logs in at the
# touchscreen.
