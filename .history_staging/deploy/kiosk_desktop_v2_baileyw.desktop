[Desktop Entry]
Type=Application
Name=RaceCount Kiosk
Comment=Launches the RaceCount touchscreen dashboard fullscreen after login
Exec=/home/baileyw/racecount/systemd/launch_kiosk.sh
X-GNOME-Autostart-enabled=true
NoDisplay=false

# Install by copying (not symlinking — some desktop session managers
# ignore autostart symlinks) into the Pi user's autostart folder:
#   mkdir -p ~/.config/autostart
#   cp racecount-kiosk.desktop ~/.config/autostart/
#   chmod +x /home/baileyw/racecount/systemd/launch_kiosk.sh
#
# This only fires once the desktop session itself has started, i.e.
# after Raspberry Pi OS's auto-login (raspi-config -> System Options ->
# Boot / Auto Login -> Desktop Autologin) — without auto-login the
# dashboard won't appear until someone logs in at the touchscreen.
